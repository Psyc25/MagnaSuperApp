# Supabase (publik, ikut ter-bundle ke browser)
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Rahasia server
SUPABASE_SERVICE_ROLE_KEY=

# Asisten AI (NOVA) -- penyedia OpenAI-compatible, lihat src/lib/ai/config.ts.
# Kosongkan saat development untuk memakai 9Router lokal (http://localhost:20128/v1).
# Production (Vercel) WAJIB diisi, contoh OpenRouter:
#   AI_API_URL=https://openrouter.ai/api/v1
#   AI_API_KEY=<API key dari openrouter.ai>
#   AI_MODEL=openai/gpt-4o-mini   (opsional; default per penyedia)
# Atau cukup nama penyedia + key (base URL otomatis):
#   AI_PROVIDER=groq              (openrouter | openai | groq | together)
AI_PROVIDER=
AI_API_URL=
AI_API_KEY=
AI_MODEL=
